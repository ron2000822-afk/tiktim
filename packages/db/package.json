    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.2",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "ws": "^8.22.1"
  }

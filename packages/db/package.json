{
  "name": "@tiktim/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/client.ts",
  "types": "./src/client.ts",
  "exports": {
    ".": "./src/client.ts",
    "./schema": "./src/schema.ts",
    "./seed-data": "./src/seed-data.ts"
  },
  "scripts": {

# Copy this file to .env.local (web + root tooling) and fill in real values.
# Never commit .env.local or any file containing real secrets.

# local | staging | production
APP_ENV=local

# --- Supabase ---
# Project Settings -> Database -> Connection string (URI). Used by packages/db (Drizzle, migrations, seed).
DATABASE_URL=

# Project Settings -> Data API. Used by the browser client (Supabase Auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API Keys. Server-only, never expose to the browser. Needed from Phase 1 (admin panel).
SUPABASE_SERVICE_ROLE_KEY=

# --- Ticketmaster (Phase 3) ---
TICKETMASTER_API_KEY=
IMPACT_TICKETMASTER_PUBLISHER_ID=

# --- Resend (Phase 4, email) ---
RESEND_API_KEY=

# --- Anthropic API (Phase 3, genre suggestions / ambiguous name matching) ---
ANTHROPIC_API_KEY=

# --- PostHog (Phase 5, analytics) ---
NEXT_PUBLIC_POSTHOG_KEY=

# --- Sentry (error monitoring) ---
SENTRY_DSN=

# Secret used to authorize calls to the on-demand ISR revalidation endpoint from the ingestion pipeline.
REVALIDATE_SECRET=

# Public site URL the ingestion pipeline calls after each run to hit /api/revalidate (e.g. https://tiktim.co.il).
SITE_URL=

# Comma-separated allowlist of Google accounts allowed into /admin.
ADMIN_EMAILS=
